body { font-family: sans-serif; background: #f4f7f6; display: flex; justify-content: center; padding: 50px; }
.calculator-card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 350px; }
label { display: block; margin-bottom: 15px; font-weight: bold; }
input { width: 100%; padding: 8px; margin-top: 5px; box-sizing: border-box; }
button { width: 100%; padding: 12px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; }
button:hover { background: #0056b3; }
h3 { margin-top: 20px; text-align: center; color: #333; }
.reset-btn { background: #6c757d; margin-top: 10px; }
.reset-btn:hover { background: #5a6268; }
